{
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/accessible",
      "destination": "/accessible.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/packs/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/build/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
